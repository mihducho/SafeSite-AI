# Mau file .env cho ung dung web SafeGate. Sao chep thanh .env (cung thu muc) roi dien gia tri that.
# .env chua bi mat: KHONG dua vao git (da co trong .gitignore).

# CSDL. MySQL 8 / MariaDB (tao CSDL safegate utf8mb4 + tai khoan safegate truoc, xem README):
DATABASE_URL=mysql+pymysql://safegate:MAT_KHAU@127.0.0.1:3307/safegate?charset=utf8mb4
# SQLite (khong can cai them):
# DATABASE_URL=sqlite:///data/safegate.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://safegate:MAT_KHAU@localhost:5432/safegate

# Khoa ky cookie dang nhap: chuoi ngau nhien dai. Tao bang:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Tai khoan quan tri ban dau (scripts\seed_demo.py tao/cap nhat)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# (tuy chon) Ghi de nguon hinh cua cong: so webcam, URL camera dien thoai (URL co mat khau dat o day), file video
# GATE_SOURCE=0
# GATE_SOURCE=data/raw/cong_gia_v1/du_do_01.mp4
# (tuy chon) 0 = khong chay vong lap cong (chi xem web)
# GATE_ENABLED=0
